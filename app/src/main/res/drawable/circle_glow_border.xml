<?xml version="1.0" encoding="utf-8"?>
<!-- Circular button with a blue-violet gradient ring (glow theme play/pause). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#3B82F6"
                android:centerColor="#7C3AED"
                android:endColor="#A855F7" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF1A1A2E" />
        </shape>
    </item>
</layer-list>
