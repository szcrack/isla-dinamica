<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Isla Dinámica"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Una píldora flotante arriba de la pantalla que muestra notificaciones y música."
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Superposición: pendiente"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permitir superposición"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvListenerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acceso a notificaciones: pendiente"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnListener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permitir acceso a notificaciones"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnNotifPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permitir notificaciones (Android 13+)"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Isla: detenida"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar isla"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku (permisos avanzados)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvShizukuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku: comprobando…"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnShizukuPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conceder permiso Shizuku"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnShizukuApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aplicar permisos con Shizuku"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swHideIcons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ocultar iconos de la barra (reloj, sistema y notificaciones)"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El reloj se oculta solo en el inicio del launcher (ahí la isla muestra la hora) y reaparece en otras apps y en el panel de control."
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvUsageAccessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conceder acceso a uso (para detectar el launcher)"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvA11yStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar detección rápida (accesibilidad)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRestoreBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurar barra de estado"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvShizukuLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posición de la isla"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La isla se centra sola en la cámara. Si queda corrida, afínala aquí (se mueve en vivo si la isla está corriendo)."
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvOffsetX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posición horizontal: 0 dp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbOffsetX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:progress="40"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvOffsetY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posición vertical: 0 dp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbOffsetY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:progress="40"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCenterIsland"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Centrar isla en la cámara"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calibración del tamaño exacto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El agujero de la cámara es redondo y el rectángulo del sistema incluye margen: afina el tamaño en píxeles hasta que cubra el agujero. Mientras mueves un deslizador la píldora se pone roja para ver su borde; al soltar vuelve a negro."
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCalW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ancho exacto: 70 px"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbCalW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="180"
            android:progress="50"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCalH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alto exacto: 70 px"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbCalH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="180"
            android:progress="50"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCalY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posición Y fina: 0 px"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbCalY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120"
            android:progress="60"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnResetCal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restablecer calibración"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tamaño y comportamiento"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajustes traídos de DynamicSpot. El tamaño es un porcentaje del agujero de la cámara (100% = exacto)."
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSizeW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ancho de la isla: 100%"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbSizeW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSizeH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alto de la isla: 100%"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbSizeH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvPopupW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ancho de la tarjeta expandida: 352 dp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbPopupW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="140"
            android:progress="72"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAutoClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar sola a los: 8 s"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbAutoClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="8"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvLongPress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque largo para abrir la app: 500 ms"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/sbLongPress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="12"
            android:progress="2"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/swSwipeDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deslizar a los lados para cerrar la isla"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swShowLockscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostrar la isla en la pantalla de bloqueo"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swNotchShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Píldora con la forma exacta de la cámara"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swVisualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visualizador de música animado"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema de la isla"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbThemeBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Negro iPhone"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbThemeFrosted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HyperOS Cristal" />

            <RadioButton
                android:id="@+id/rbThemeGlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HyperOS Brillo" />
        </RadioGroup>

    </LinearLayout>
</ScrollView>
